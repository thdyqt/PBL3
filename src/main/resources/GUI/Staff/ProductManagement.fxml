<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainPane" prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #F8FAFC;" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.Staff.ProductManagementForm">
    <top>
        <VBox spacing="15.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Label text="Quản lý Sản phẩm" textFill="#1E293B">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnBack" mnemonicParsing="false" onAction="#handleBack" onMouseClicked="#handleBack" style="-fx-background-color: #94A3B8; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 15;" text="Quay lại">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 3);">
                    <padding>
                        <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
                    </padding>
                    <children>
                        <TextField fx:id="txtSearch" prefWidth="250.0" promptText="🔍 Tìm kiếm tên sản phẩm..." style="-fx-background-color: #F1F5F9; -fx-background-radius: 5; -fx-padding: 8 12; -fx-text-fill: #1E293B;">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </TextField>

                        <ComboBox fx:id="cbCategory" prefWidth="180.0" promptText="Tất cả danh mục" style="-fx-background-color: #F1F5F9; -fx-background-radius: 5; -fx-padding: 4 8;" />

                        <CheckBox fx:id="chkShowInactive" mnemonicParsing="false" onAction="#handleShowInactive" style="-fx-text-fill: #64748B; -fx-font-weight: bold;" text="SP đã ngừng kinh doanh">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </CheckBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <Button fx:id="btnAdd" mnemonicParsing="false" onAction="#handleAdd" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 15;" text="+ Thêm mới">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>

                        <Button fx:id="btnEdit" mnemonicParsing="false" onAction="#handleEdit" style="-fx-background-color: #3B82F6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 15;" text="✏ Sửa thông tin">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>

                        <Button fx:id="btnDisable" mnemonicParsing="false" onAction="#handleDisable" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 15;" text="⛔ Ngừng KD">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 3);" BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets bottom="10.0" left="20.0" right="20.0" top="0.0" />
            </BorderPane.margin>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <TableView fx:id="tblProduct" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colSTT" prefWidth="50.0" style="-fx-alignment: CENTER; -fx-font-weight: bold;" text="STT" />
                        <TableColumn fx:id="colProductName" prefWidth="220.0" style="-fx-alignment: CENTER_LEFT; -fx-font-weight: bold; -fx-padding: 0 0 0 10;" text="Tên Sản Phẩm" />
                        <TableColumn fx:id="colCategory" prefWidth="130.0" style="-fx-alignment: CENTER;" text="Danh Mục" />
                        <TableColumn fx:id="colProductPrice" prefWidth="120.0" style="-fx-alignment: CENTER_RIGHT; -fx-font-weight: bold; -fx-text-fill: #EF4444; -fx-padding: 0 10 0 0;" text="Giá (VNĐ)" />
                        <TableColumn fx:id="colQuantity" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Số Lượng" />
                        <TableColumn fx:id="colIsAvailable" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Trạng Thái" />
                        <TableColumn fx:id="colImage" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Hình Ảnh" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="10">
                            <Label style="-fx-font-size: 40px; -fx-opacity: 0.3;" text="🍞" />
                            <Label style="-fx-font-size: 15px; -fx-text-fill: #64748B;" text="Chưa có sản phẩm nào" />
                        </VBox>
                    </placeholder>
                </TableView>
            </children>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="5.0" />
            </padding>
            <children>
                <Label fx:id="lblStatus" style="-fx-font-size: 13px; -fx-text-fill: #10B981; -fx-font-weight: bold;" text="Sẵn sàng" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblCount" style="-fx-font-size: 13px; -fx-text-fill: #64748B; -fx-font-weight: bold;" text="0 sản phẩm" />
                <Label style="-fx-text-fill: #CBD5E1;" text="|" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #94A3B8;" text="DUT Bakery System © 2026" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
