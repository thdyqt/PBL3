<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1100.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.Customer.MyOrderController">

    <top>
        <!-- ══ HEADER ══ -->
        <VBox style="-fx-background-color: white; -fx-border-color: transparent transparent #E2E8F0 transparent; -fx-border-width: 0 0 1 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 2);">

            <!-- Title bar -->
            <HBox alignment="CENTER_LEFT" prefHeight="64" spacing="12">
                <padding>
                    <Insets left="35" right="35" />
                </padding>
                <Label style="-fx-font-size: 16px; -fx-text-fill: #94A3B8;" text="📋" />
                <VBox spacing="1">
                    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Đơn hàng của tôi" />
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #64748B;" text="Lịch sử giao dịch &amp; theo dõi đơn hàng" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER_LEFT" minWidth="260.0" prefWidth="260.0" maxWidth="260.0" prefHeight="38.0" maxHeight="38.0" spacing="8" style="-fx-background-color: #F1F5F9; -fx-border-color: #E2E8F0; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 14 0 14;">
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #94A3B8;" text="🔍" />
                    <TextField fx:id="txtSearch" promptText="Tìm theo mã đơn..." style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 14px; -fx-text-fill: #1E293B;" HBox.hgrow="ALWAYS" />
                </HBox>
            </HBox>

            <!-- ══ THỐNG KÊ ══ -->
            <HBox spacing="0" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0 transparent transparent transparent; -fx-border-width: 1 0 0 0;">
                <padding>
                    <Insets bottom="16" left="35" right="35" top="16" />
                </padding>

                <!-- Stat 1: Tổng đơn -->
                <VBox alignment="CENTER" prefWidth="160" spacing="3">
                    <Label fx:id="lblTotalOrders" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #3B82F6;" text="0" />
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #64748B; -fx-font-weight: bold;" text="TỔNG ĐƠN HÀNG" />
                </VBox>

                <Region style="-fx-background-color: #E2E8F0; -fx-pref-width: 1; -fx-min-width: 1;" />

                <!-- Stat 2: Hoàn thành -->
                <VBox alignment="CENTER" prefWidth="160" spacing="3">
                    <Label fx:id="lblDoneOrders" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #10B981;" text="0" />
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #64748B; -fx-font-weight: bold;" text="HOÀN THÀNH" />
                </VBox>

                <Region style="-fx-background-color: #E2E8F0; -fx-pref-width: 1; -fx-min-width: 1;" />

                <!-- Stat 3: Đang xử lý -->
                <VBox alignment="CENTER" prefWidth="160" spacing="3">
                    <Label fx:id="lblActiveOrders" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #F59E0B;" text="0" />
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #64748B; -fx-font-weight: bold;" text="ĐANG XỬ LÝ" />
                </VBox>

                <Region style="-fx-background-color: #E2E8F0; -fx-pref-width: 1; -fx-min-width: 1;" />

                <!-- Stat 4: Đã hủy -->
                <VBox alignment="CENTER" prefWidth="160" spacing="3">
                    <Label fx:id="lblCancelOrders" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #EF4444;" text="0" />
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #64748B; -fx-font-weight: bold;" text="ĐÃ HỦY" />
                </VBox>

                <Region style="-fx-background-color: #E2E8F0; -fx-pref-width: 1; -fx-min-width: 1;" />

                <!-- Stat 5: Tổng chi tiêu -->
                <VBox alignment="CENTER" spacing="3" HBox.hgrow="ALWAYS">
                    <Label fx:id="lblTotalSpent" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="0 đ" />
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #64748B; -fx-font-weight: bold;" text="TỔNG CHI TIÊU" />
                </VBox>
            </HBox>

            <!-- ══ FILTER TABS ══ -->
            <HBox alignment="CENTER_LEFT" prefHeight="50" spacing="10" style="-fx-background-color: white; -fx-border-color: #E2E8F0 transparent transparent transparent; -fx-border-width: 1 0 0 0;">
                <padding>
                    <Insets left="35" right="35" />
                </padding>
                <fx:define>
                    <ToggleGroup fx:id="filterGroup" />
                </fx:define>

                <ToggleButton fx:id="tabAll" mnemonicParsing="false" onAction="#handleFilter" selected="true" style="-fx-background-color: #3B82F6; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 6 18; -fx-cursor: hand;" text="Tất cả" toggleGroup="$filterGroup" userData="ALL" />
                <ToggleButton fx:id="tabWaiting" mnemonicParsing="false" onAction="#handleFilter" style="-fx-background-color: #FEF3C7; -fx-text-fill: #D97706; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 6 18; -fx-cursor: hand;" text="⏳ Chờ xác nhận" toggleGroup="$filterGroup" userData="Chờ xác nhận" />
                <ToggleButton fx:id="tabPreparing" mnemonicParsing="false" onAction="#handleFilter" style="-fx-background-color: #EFF6FF; -fx-text-fill: #2563EB; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 6 18; -fx-cursor: hand;" text="👨‍🍳 Đang xử lý" toggleGroup="$filterGroup" userData="Đang chuẩn bị" />
                <ToggleButton fx:id="tabShipping" mnemonicParsing="false" onAction="#handleFilter" style="-fx-background-color: #F3E8FF; -fx-text-fill: #7E22CE; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 6 18; -fx-cursor: hand;" text="🚗 Đang giao" toggleGroup="$filterGroup" userData="Đang giao" />
                <ToggleButton fx:id="tabDone" mnemonicParsing="false" onAction="#handleFilter" style="-fx-background-color: #D1FAE5; -fx-text-fill: #059669; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 6 18; -fx-cursor: hand;" text="✅ Hoàn thành" toggleGroup="$filterGroup" userData="Hoàn thành" />
                <ToggleButton fx:id="tabCancelled" mnemonicParsing="false" onAction="#handleFilter" style="-fx-background-color: #FEE2E2; -fx-text-fill: #DC2626; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 6 18; -fx-cursor: hand;" text="❌ Đã hủy" toggleGroup="$filterGroup" userData="Đã hủy" />

                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblOrderCount" style="-fx-font-size: 13px; -fx-text-fill: #64748B; -fx-font-weight: bold;" text="0 đơn hàng" />
            </HBox>
        </VBox>
    </top>

    <center>
        <!-- ══ DANH SÁCH ORDER ══ -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: #F8FAFC; -fx-border-color: transparent;">
            <padding>
                <Insets bottom="30" left="35" right="35" top="20" />
            </padding>
            <content>
                <VBox fx:id="orderContainer" spacing="16" style="-fx-background-color: transparent;">

                    <!-- Placeholder khi không có đơn -->
                    <StackPane fx:id="emptyPlaceholder" managed="false" prefHeight="300" visible="false">
                        <VBox alignment="CENTER" spacing="12">
                            <Label style="-fx-font-size: 56px; -fx-opacity: 0.3;" text="📋" />
                            <Label style="-fx-font-size: 18px; -fx-text-fill: #64748B; -fx-font-weight: bold;" text="Bạn chưa có đơn hàng nào" />
                            <Label style="-fx-font-size: 14px; -fx-text-fill: #94A3B8;" text="Hãy đặt hàng ngay để thưởng thức những món ngon từ DUT Bakery!" />
                        </VBox>
                    </StackPane>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>