<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.web.WebView?>

<AnchorPane fx:id="mainPane" prefHeight="750.0" prefWidth="1000.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.Customer.CustomerHomeController">
    <children>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox spacing="30.0">
                    <padding>
                        <Insets bottom="40.0" left="30.0" right="30.0" top="20.0" />
                    </padding>
                    <children>

                        <!-- ══ HEADER: Welcome + Search ══ -->
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <children>
                                <VBox>
                                    <children>
                                        <Label fx:id="lblWelcome" style="-fx-text-fill: #1E293B;" text="Chào buổi sáng, Duy!">
                                            <font>
                                                <Font name="System Bold" size="24.0" />
                                            </font>
                                        </Label>
                                        <Label style="-fx-text-fill: #64748B;" text="Hôm nay bạn muốn thưởng thức món bánh gì?" />
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <HBox alignment="CENTER_LEFT" maxWidth="400.0" prefHeight="45.0" prefWidth="280.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 3); -fx-padding: 0 15; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-border-width: 1;">
                                    <children>
                                        <Label style="-fx-text-fill: #94A3B8;" text="🔍">
                                            <font>
                                                <Font size="16.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="txtSearch" promptText="Tìm kiếm bánh kem, bánh mì..." style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-text-fill: #1E293B;" HBox.hgrow="ALWAYS">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </TextField>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <!-- ══ BANNER ══ -->
                        <StackPane fx:id="paneBanner" prefHeight="280.0" style="-fx-background-color: #1E293B; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);">
                            <children>
                                <Region style="-fx-background-color: linear-gradient(to right, rgba(15, 23, 43, 0.8) 0%, rgba(30, 41, 59, 0.4) 60%, transparent 100%); -fx-background-radius: 16;" />

                                <VBox alignment="CENTER_LEFT" pickOnBounds="false" spacing="12.0">
                                    <padding>
                                        <Insets left="60.0" right="60.0" />
                                    </padding>
                                    <children>
                                        <Label style="-fx-text-fill: white;" text="DUT Bakery">
                                            <font>
                                                <Font name="System Bold" size="40.0" />
                                            </font>
                                        </Label>
                                        <Label maxWidth="500.0" style="-fx-text-fill: #CBD5E1;" text="Hương vị trọn vẹn từ sự tận tâm.&#10;Thưởng thức bánh tươi mới mỗi ngày với nguyên liệu hảo hạng nhất." wrapText="true">
                                            <font>
                                                <Font size="16.0" />
                                            </font>
                                        </Label>
                                        <Region prefHeight="10.0" />
                                        <Button mnemonicParsing="false" onAction="#handleViewMenu" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 35; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(16, 185, 129, 0.4), 10, 0, 0, 4);" text="XEM MENU NGAY">
                                            <cursor>
                                                <Cursor fx:constant="HAND" />
                                            </cursor>
                                            <font>
                                                <Font size="15.0" />
                                            </font>
                                        </Button>
                                    </children>
                                </VBox>

                                <!-- Bỏ chặn chuột xuyên thấu cho HBox chứa dấu chấm -->
                                <HBox fx:id="hboxBannerIndicators" alignment="BOTTOM_CENTER" fillHeight="false" pickOnBounds="false" spacing="10.0" StackPane.alignment="BOTTOM_CENTER">
                                    <padding>
                                        <Insets bottom="20.0" />
                                    </padding>
                                </HBox>
                            </children>
                        </StackPane>

                        <!-- ══ DANH MỤC ══ -->
                        <VBox spacing="15.0">
                            <children>
                                <Label style="-fx-text-fill: #1E293B;" text="Danh mục nổi bật">
                                    <font>
                                        <Font name="System Bold" size="20.0" />
                                    </font>
                                </Label>
                                <HBox fx:id="hboxCategories" alignment="CENTER_LEFT" spacing="20.0" />
                            </children>
                        </VBox>

                        <!-- ══ MÃ KHUYẾN MÃI ══ -->
                        <VBox spacing="12" style="-fx-background-color: #EFF6FF; -fx-background-radius: 12; -fx-padding: 20; -fx-border-color: #BFDBFE; -fx-border-width: 1; -fx-border-radius: 12;">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <children>
                                        <Label style="-fx-font-size: 18px;" text="🎟️" />
                                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E3A8A;" text="Mã Khuyến Mãi Đang Hoạt Động" />
                                    </children>
                                </HBox>
                                <HBox fx:id="hboxPromoCodes" spacing="12" />
                            </children>
                        </VBox>

                        <!-- ══ BEST SELLERS ══ -->
                        <VBox spacing="15.0">
                            <children>
                                <Label style="-fx-text-fill: #1E293B;" text="🔥 Món bánh bán chạy">
                                    <font>
                                        <Font name="System Bold" size="22.0" />
                                    </font>
                                </Label>
                                <ScrollPane fitToHeight="true" minHeight="300.0" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" vbarPolicy="NEVER">
                                    <content>
                                        <HBox fx:id="hboxBestSellers" spacing="25.0" />
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>

                        <!-- ══ NEW ARRIVALS ══ -->
                        <VBox spacing="15.0">
                            <children>
                                <Label style="-fx-text-fill: #1E293B;" text="✨ Bánh mới ra lò">
                                    <font>
                                        <Font name="System Bold" size="22.0" />
                                    </font>
                                </Label>
                                <ScrollPane fitToHeight="true" minHeight="300.0" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" vbarPolicy="NEVER">
                                    <content>
                                        <HBox fx:id="hboxNewArrivals" spacing="25.0" />
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>

                        <!-- ══ ĐƠN HÀNG GẦN NHẤT ══ -->
                        <VBox spacing="12">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <children>
                                        <Label style="-fx-font-size: 18px;" text="📋" />
                                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Đơn Hàng Gần Nhất" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblViewAllOrders" onMouseClicked="#handleViewAllOrders" style="-fx-font-size: 14px; -fx-text-fill: #3B82F6; -fx-cursor: hand; -fx-font-weight: bold;" text="Xem tất cả →" />
                                    </children>
                                </HBox>
                                <VBox fx:id="vboxRecentOrders" spacing="10" />
                            </children>
                        </VBox>

                        <!-- ══ THÔNG TIN VỀ CHÚNG TÔI ══ -->
                        <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 30; -fx-border-color: #E2E8F0; -fx-border-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 3);">
                            <children>
                                <HBox spacing="30">
                                    <children>

                                        <!-- Cột trái: Thông tin -->
                                        <VBox spacing="16" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #3B82F6;" text="DUT BAKERY" />
                                                <Label style="-fx-font-size: 14px; -fx-text-fill: #64748B; -fx-wrap-text: true;" text="Bánh mì tươi ngon mỗi ngày — được làm từ những nguyên liệu tự nhiên, chọn lọc kỹ càng. Hương vị đậm đà, chuẩn phong cách hiện đại." wrapText="true" />

                                                <!-- Địa chỉ -->
                                                <HBox alignment="CENTER_LEFT" spacing="8">
                                                    <children>
                                                        <Label style="-fx-font-size: 16px; -fx-text-fill: #94A3B8;" text="📍" />
                                                        <Label style="-fx-font-size: 14px; -fx-text-fill: #334155; -fx-font-weight: bold;" text="54 Nguyễn Lương Bằng, P. Hòa Khánh, Đà Nẵng" />
                                                    </children>
                                                </HBox>

                                                <!-- Giờ mở cửa -->
                                                <HBox alignment="CENTER_LEFT" spacing="8">
                                                    <children>
                                                        <Label style="-fx-font-size: 16px; -fx-text-fill: #94A3B8;" text="🕐" />
                                                        <Label style="-fx-font-size: 14px; -fx-text-fill: #334155; -fx-font-weight: bold;" text="7:00 - 22:00 hàng ngày" />
                                                    </children>
                                                </HBox>

                                                <!-- Điện thoại -->
                                                <HBox alignment="CENTER_LEFT" spacing="8">
                                                    <children>
                                                        <Label style="-fx-font-size: 16px; -fx-text-fill: #94A3B8;" text="📞" />
                                                        <Label style="-fx-font-size: 14px; -fx-text-fill: #334155; -fx-font-weight: bold;" text="0346 327 123" />
                                                    </children>
                                                </HBox>

                                                <!-- Mạng xã hội -->
                                                <HBox spacing="10">
                                                    <children>
                                                        <Label onMouseClicked="#handleOpenFacebook" style="-fx-background-color: #EFF6FF; -fx-text-fill: #2563EB; -fx-padding: 8 16; -fx-background-radius: 6; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" text="Facebook" />
                                                        <Label onMouseClicked="#handleOpenInstagram" style="-fx-background-color: #FEF2F2; -fx-text-fill: #E11D48; -fx-padding: 8 16; -fx-background-radius: 6; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" text="Instagram" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <!-- Cột phải: Bản đồ -->
                                        <VBox alignment="CENTER" prefWidth="400" spacing="8">
                                            <children>
                                                <Label style="-fx-font-size: 14px; -fx-text-fill: #64748B; -fx-font-weight: bold;" text="Bản đồ cửa hàng" />
                                                <WebView fx:id="mapView" prefHeight="220" prefWidth="400" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);" />
                                            </children>
                                        </VBox>

                                    </children>
                                </HBox>

                                <!-- Copyright -->
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;" text="© 2026 DUT Bakery System. All rights reserved." />
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>