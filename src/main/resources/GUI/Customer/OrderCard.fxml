<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-width: 1; -fx-border-radius: 12; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 10, 0, 0, 2);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.Customer.OrderCardController">

    <!-- ══ HEADER CARD ══ -->
    <HBox alignment="CENTER_LEFT" prefHeight="50" spacing="10" style="-fx-background-color: #F8FAFC; -fx-border-color: transparent transparent #E2E8F0 transparent; -fx-border-width: 0 0 1 0; -fx-background-radius: 12 12 0 0;">
        <padding>
            <Insets left="20" right="20" />
        </padding>

        <!-- Mã đơn -->
        <Label style="-fx-font-size: 14px; -fx-text-fill: #94A3B8;" text="📋" />
        <Label fx:id="lblOrderID" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="#DH000" />

        <Label style="-fx-text-fill: #CBD5E1;" text="·" />

        <!-- Ngày đặt -->
        <Label style="-fx-font-size: 14px; -fx-text-fill: #94A3B8;" text="🗓" />
        <Label fx:id="lblOrderDate" style="-fx-font-size: 14px; -fx-text-fill: #64748B;" text="22/04/2026" />

        <Region HBox.hgrow="ALWAYS" />

        <!-- Trạng thái -->
        <Label fx:id="lblStatus" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 5 14; -fx-background-radius: 20; -fx-background-color: #FEF3C7; -fx-text-fill: #D97706;" text="Chờ xác nhận" />
    </HBox>

    <!-- ══ TÊN SẢN PHẨM ══ -->
    <HBox alignment="CENTER_LEFT" prefHeight="36" spacing="8">
        <padding>
            <Insets left="20" right="20" top="5" />
        </padding>
        <Label style="-fx-font-size: 13px; -fx-text-fill: #64748B;" text="Sản phẩm:" />
        <Label fx:id="lblProductNames" style="-fx-font-size: 14px; -fx-text-fill: #334155; -fx-font-weight: bold;" text="Bánh mì thịt, Hamburger bò,..." />
    </HBox>

    <!-- ══ SCROLL ẢNH SẢN PHẨM (Đã chuyển Padding vào HBox) ══ -->
    <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" prefHeight="115" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent; -fx-padding: 0;" vbarPolicy="NEVER">
        <content>
            <HBox fx:id="imageContainer" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: transparent; -fx-padding: 5 20 10 20;" />
        </content>
    </ScrollPane>

    <!-- ══ FOOTER CARD ══ -->
    <HBox alignment="CENTER_LEFT" prefHeight="56" spacing="12" style="-fx-border-color: #E2E8F0 transparent transparent transparent; -fx-border-width: 1 0 0 0;">
        <padding>
            <Insets left="20" right="20" />
        </padding>

        <!-- Số lượng sản phẩm -->
        <Label style="-fx-font-size: 14px; -fx-text-fill: #94A3B8;" text="🛍" />
        <Label fx:id="lblItemCount" style="-fx-font-size: 14px; -fx-text-fill: #64748B; -fx-font-weight: bold;" text="3 món" />

        <Region HBox.hgrow="ALWAYS" />

        <!-- Tổng tiền -->
        <Label style="-fx-font-size: 14px; -fx-text-fill: #64748B;" text="Tổng:" />
        <Label fx:id="lblTotal" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #D4891A;" text="85.000 đ" />

        <Region prefWidth="10" />




        <!-- Nút Xem chi tiết -->
        <Button fx:id="btnDetail" onAction="#handleDetail" onMouseClicked="#handleDetail" prefHeight="36" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 20; -fx-cursor: hand;" text="Xem chi tiết →" />
    </HBox>

</VBox>
